{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Warning"
    }
  },
  "MediaTransfers": {
    "MaxUploadBytes": 33554432,
    "ConcurrentTransfers": 8,
    "TimeoutSeconds": 120,
    "QuarantineDirectory": ".quarantine"
  },
  "MediaProcessing": {
    "Enabled": false
  }
}
