{
  "name": "bulgaria-archive-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "npm run migrate && node dist/main",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check src test scripts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 test/*.e2e-spec.ts",
    "migrate": "node scripts/migrate.mjs",
    "seed:dev": "node scripts/seed.mjs",
    "seed:staging": "node scripts/seed.mjs --staging",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.5.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.3.1",
    "handlebars": "4.7.10",
    "helmet": "^8.3.0",
    "mongoose": "9.12.1",
    "ms": "2.1.3",
    "nestjs-i18n": "10.6.0",
    "nodemailer": "10.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@types/express": "5.0.6",
    "@types/ms": "2.1.0",
    "@types/node": "25.5.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "^17.4.0",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
