NODE_ENV=development
APP_PORT=3000
APP_NAME=The Bulgaria We Lost
FRONTEND_DOMAIN=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200
APP_TRUST_PROXY_HOPS=0
DATABASE_URL=mongodb://127.0.0.1:27017/bulgaria_archive?replicaSet=rs0&directConnection=true

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_DEFAULT_EMAIL=noreply@example.test
MAIL_DEFAULT_NAME=The Bulgaria We Lost
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false

# Development placeholders. Production rejects them.
AUTH_JWT_SECRET=secret
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_MFA_ENCRYPTION_KEY=
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
