{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Warning"
    }
  },
  "MediaTransfers": {
    "MaxUploadBytes": 33554432,
    "ConcurrentTransfers": 8,
    "TimeoutSeconds": 120,
    "QuarantineDirectory": ".quarantine",
    "QuarantineRetentionMinutes": 60,
    "QuarantineCleanupIntervalSeconds": 300
  },
  "MediaStorage": {
    "PartialRetentionMinutes": 60,
    "CleanupIntervalSeconds": 300
  },
  "MediaProcessing": {
    "Enabled": false
  }
}
