{
  "MediaControl": {
    "BaseUrl": "http://127.0.0.1:3000/"
  },
  "MediaStorage": {
    "PartialRetentionMinutes": 60,
    "CleanupIntervalSeconds": 300,
    "Profiles": {
      "archive": {
        "Host": "127.0.0.1",
        "Port": 2222,
        "Username": "media",
        "PrivateKeyPath": "/path/to/media-client-key",
        "HostKeySha256": "SHA256:replace-with-the-approved-host-fingerprint",
        "Root": "/archive"
      }
    }
  }
}
