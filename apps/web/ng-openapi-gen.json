{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "../../contracts/openapi/v1.yaml",
  "output": "src/app/api/generated",
  "excludeTags": ["Internal media", "Internal operations"],
  "promises": false,
  "services": true,
  "apiService": "ArchiveApi",
  "configuration": "ArchiveApiConfiguration",
  "removeStaleFiles": true,
  "endOfLineStyle": "lf"
}
