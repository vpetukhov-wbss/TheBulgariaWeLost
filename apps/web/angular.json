{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "bulgaria-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": [
              "@fontsource/open-sans/latin-400.css",
              "@fontsource/open-sans/cyrillic-400.css",
              "@fontsource/open-sans/latin-600.css",
              "@fontsource/open-sans/cyrillic-600.css",
              "@fontsource/open-sans/latin-700.css",
              "@fontsource/open-sans/cyrillic-700.css",
              "@nebular/theme/styles/prebuilt/default.css",
              "src/styles.scss"
            ],
            "assets": [{ "glob": "episode-share.png", "input": "src/assets", "output": "assets" }],
            "polyfills": ["zone.js"],
            "allowedCommonJsDependencies": ["eva-icons"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.15MB",
                  "maximumError": "1.25MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "mock": {
              "browser": "src/main.mock.ts",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "*.jpg",
                  "input": "src/mock-assets",
                  "output": "mock-assets"
                }
              ],
              "outputPath": "dist/bulgaria-web-mock",
              "styles": [
                "@fontsource/open-sans/latin-400.css",
                "@fontsource/open-sans/cyrillic-400.css",
                "@fontsource/open-sans/latin-600.css",
                "@fontsource/open-sans/cyrillic-600.css",
                "@fontsource/open-sans/latin-700.css",
                "@fontsource/open-sans/cyrillic-700.css",
                "@nebular/theme/styles/prebuilt/default.css",
                "src/styles.scss",
                "src/app/mock/mock.scss",
                "src/app/mock/component-pages.scss"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "bulgaria-web:build:production"
            },
            "development": {
              "buildTarget": "bulgaria-web:build:development"
            },
            "mock": {
              "buildTarget": "bulgaria-web:build:mock"
            }
          },
          "defaultConfiguration": "mock",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    }
  }
}
