{
  "name": "bulgaria-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "format:check": "prettier --check src e2e playwright.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "api:generate": "ng-openapi-gen",
    "api:check": "npm run api:generate && node scripts/check-generated.mjs",
    "contract:validate": "node scripts/check-openapi-compatibility.mjs ../../contracts/openapi/v1.yaml",
    "start:mock": "ng serve --configuration mock",
    "build:mock": "ng build --configuration mock"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/cdk": "21.0.6",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@fontsource/open-sans": "5.3.0",
    "@nebular/auth": "17.0.0",
    "@nebular/eva-icons": "17.0.0",
    "@nebular/security": "17.0.0",
    "@nebular/theme": "17.0.0",
    "@ngrx/signals": "21.1.1",
    "eva-icons": "1.1.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
